<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="LazInk"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="TonyStone"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)/$(LCLWidgetType)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="ObjFPC"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Description Value="LazInk — lightweight HTML-formatted text controls drawn entirely with TCanvas: TInkLabel, TInkEdit (per-character colored edit box), TInkRichEdit (multi-line WYSIWYG editor with caret and selection inside the rendered text), TInkMemo and TInkListBox. Renders a simple HTML subset (bold, italic, underline, strikeout, font color/bgcolour/size/face, sub/sup, paragraphs, alignment, links) identically on every LCL widgetset including gtk3."/>
    <License Value="0BSD - do whatever you want with it. Every unit is LazInk's own; see LICENSE."/>
    <Version Major="1"/>
    <Files>
      <Item><Filename Value="inkscrollbar.pas"/><UnitName Value="InkScrollBar"/></Item>
      <Item><Filename Value="inktouch.pas"/><UnitName Value="InkTouch"/></Item>
      <Item><Filename Value="inkcopymenu.pas"/><UnitName Value="InkCopyMenu"/></Item>
      <Item><Filename Value="inkgif.pas"/><UnitName Value="InkGIF"/></Item>
      <Item><Filename Value="inkcss.pas"/><UnitName Value="InkCSS"/></Item>
      <Item><Filename Value="inkcode.pas"/><UnitName Value="InkCode"/></Item>
      <Item><Filename Value="inkwebp.pas"/><UnitName Value="InkWebP"/></Item>
      <Item><Filename Value="inkbox.pas"/><UnitName Value="InkBox"/></Item>
      <Item><Filename Value="inkrender.pas"/><UnitName Value="InkRender"/></Item>
      <Item><Filename Value="inkdraw.pas"/><UnitName Value="InkDraw"/></Item>
      <Item><Filename Value="inkpage.pas"/><UnitName Value="InkPage"/></Item>
      <Item>
        <Filename Value="inkmarkdown.pas"/>
        <UnitName Value="InkMarkdown"/>
      </Item>
      <Item>
        <Filename Value="inklabel.pas"/>
        <UnitName Value="InkLabel"/>
      </Item>
      <Item>
        <Filename Value="inkedit.pas"/>
        <UnitName Value="InkEdit"/>
      </Item>
      <Item>
        <Filename Value="inkmemo.pas"/>
        <UnitName Value="InkMemo"/>
      </Item>
      <Item>
        <Filename Value="inklistbox.pas"/>
        <UnitName Value="InkListBox"/>
      </Item>
      <Item>
        <Filename Value="inkrichedit.pas"/>
        <UnitName Value="InkRichEdit"/>
      </Item>
      <Item>
        <Filename Value="lazinkreg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="LazInkReg"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="LazUtils"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>

      object memCheat: TInkMemo
        Cursor = crIBeam
        Left = 0
        Height = 698
        Top = 0
        Width = 878
        Lines.Strings = (
          '<font size="16"><b>The markup LazInk understands</b></font>'
          '<b>&lt;b&gt;</b> <b>bold</b>   <b>&lt;i&gt;</b> <i>italic</i>   <b>&lt;u&gt;</b> <u>underline</u>   <b>&lt;s&gt;</b> <s>strikeout</s>'
          '<b>&lt;font color="#RRGGBB"&gt;</b> — <font color="#C0392B">red</font>, <font color="#1E8449">green</font>, <font color="#2E86DE">blue</font>. Named colors work too: <font color="olive">olive</font>, <font color="clPurple">clPurple</font>.'
          '<b>&lt;font bgcolor="#RRGGBB"&gt;</b> — <font bgcolor="#FBEEA8">a highlighter pen</font>, useful for search hits.'
          '<b>&lt;font size="n"&gt;</b> — <font size="9">nine</font>, <font size="12">twelve</font>, <font size="18">eighteen</font>.'
          '<b>&lt;font face="name"&gt;</b> — <font face="DejaVu Serif">a serif face</font>, <font face="DejaVu Sans Mono">a monospaced one</font>.'
          '<b>&lt;sup&gt;</b> and <b>&lt;sub&gt;</b> — E=mc<sup>2</sup>, H<sub>2</sub>O, x<sup>n</sup>+y<sup>n</sup>.'
          '<b>&lt;a href="..."&gt;</b> — <a href="https://wiki.lazarus.freepascal.org/">a link that fires OnLinkClick</a>. Run the mouse over it: LinkHoverStyle repaints just that one.'
          '<b>&lt;img src="n"&gt;</b> — entry n of the Images list: <img src="0"> info, <img src="2"> warning, <img src="3"> error, <img src="1"> done.'
          '<b>&lt;br&gt;</b> breaks a line.<br>Like that.'
          '<b>&lt;p&gt;...&lt;/p&gt;</b> is a paragraph: a break plus a blank line.<p>Like this one.</p>'
          '<b>&lt;center&gt;</b> and <b>&lt;right&gt;</b> move a whole line:'
          '<center>this line is centered</center>'
          '<right>and this one is right aligned</right>'
          '<b>&lt;hr&gt;</b> draws a rule:'
          '<hr>'
          '<b>&lt;table&gt;</b> makes a grid, sized to its words:<table><tr><th>Tag</th><th>Draws</th></tr><tr><td>&lt;b&gt;</td><td><b>bold</b></td></tr><tr><td>&lt;a href&gt;</td><td><a href="https://www.lazarus-ide.org/">a link</a>, still clickable</td></tr></table>'
          '<b>Entities</b> — &amp;amp; &amp;lt; &amp;gt; &amp;quot; &amp;nbsp; &amp;copy; &amp;reg; &amp;trade; &amp;euro; give &amp; &lt; &gt; &quot; &copy; &reg; &trade; &euro;'
          '<b>Line breaking</b> — CJK has no spaces between words, so every character is somewhere a line may break. Without that this paragraph could not wrap at all: 日本語のテキストは空白で単語を区切らないため、どの文字の後ろでも折り返すことができます。句読点は行頭に来ないように前の文字と一緒に運ばれます。'
          '<b>Borders</b> — this memo keeps 8 pixels clear at each side and 2 above and below every row, which is why the text is not jammed against the edge. In a memo or a listbox the top and bottom borders are row padding, because each row is drawn on its own; <b>LineSpacing</b> is what separates the lines <i>inside</i> one row.'
          '<font color="#7F8C8D">Turn WordWrap off on the right and this paragraph will run off the edge instead of re-flowing, which is what the renderer did before wrapping existed. Drag the window narrower to watch it re-measure.</font>'
        )
        SuperSubScriptRatio = 0.7
        Borders.Left = 8
        Borders.Top = 7
        Borders.Right = 8
        Borders.Bottom = 7
        Images = ilStatus
        LinkStyle.Color = clBlue
        LinkStyle.BackColor = clNone
        LinkStyle.Underline = False
        LinkHoverStyle.Color = clRed
        LinkHoverStyle.BackColor = 14548991
        LinkHoverStyle.Underline = True
        OnLinkClick = memLinkClick
        WordWrap = True
        Align = alClient
        Color = clWindow
        Font.Color = clWindowText
        Font.Height = -14
        ParentColor = False
        ParentFont = False
        TabOrder = 1
      end
    end

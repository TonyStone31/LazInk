          Width = 236
          Caption = '<b>TInkMemo</b> is for text the <b>program</b> adds a line at a time - a log, a chat, a history of events. <font face="DejaVu Sans Mono">Append</font> adds a line and follows the end when you are there.<br><br><b>Not</b> a document: a whole help page or README belongs in <b>TInkPage</b> (Documents tab). <b>Not</b> an editor: text the user writes belongs in <b>TInkRichEdit</b>. <b>Not</b> a list: lines the user picks or renames belong in <b>TInkListBox</b>.<br><br>Select across lines, double-click a word, triple-click a line, Ctrl+A / Ctrl+C, right-click to copy.'
          SuperSubScriptRatio = 0.7

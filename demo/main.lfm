    object tabCredits: TTabSheet
      Caption = 'Credits'
      ClientHeight = 698
      ClientWidth = 1138
      object memCredits: TInkMemo
        Cursor = crIBeam
        Left = 0
        Height = 698
        Top = 0
        Width = 1138
        Lines.Strings = (
          '<font size="17"><b>LazInk — credits and origins</b></font>'
          'LazInk started with a Lazarus forum thread Tony Stone began in August 2021, <a href="https://forum.lazarus.freepascal.org/index.php/topic,55971.0.html">Memo Component that supports HTML markup</a>, asking for a simple way to decorate list box text with a little HTML.'
          'wp suggested taking what was needed from the HTML drawing code in Project JEDI''s JVCL and helped make it happen, with a standalone unit and an owner-drawn list box example. Tony''s demo built on that example - the List box tab here - is where the idea for LazInk was born. The components have been LazInk''s own since.'
          'AI assistants helped teach the component creation process and worked on design, implementation and debugging.'
          '<font size="15"><b>Project JEDI / JVCL</b></font>'
          'The HTML renderer used to be adapted JVCL code from JvHTControls and JvJVCLUtils. It has been replaced by LazInk''s own and deleted; the credit stays, because that code is what got LazInk off the ground.'
          'JvHTControls: Andrei Prygounkov; contributors include Maciej Kaczkowski, Timo Tegtmeier, and Andreas Hausladen.'
          'JvJVCLUtils: Fedor Koshevnikov, Igor Pavluk, Serge Korolev, and SGB Software.'
          '<a href="https://github.com/project-jedi/jvcl">Project JEDI / JVCL</a>'
          '<font size="15"><b>Thanks</b></font>'
          '<b>wp</b> - the JVCL route, the standalone unit and the list box example LazInk started from.   <b>Project JEDI / JVCL</b> - the drawing code it grew from.   <b>Lazarus and Free Pascal</b>.'
          '<font size="15"><b>Licensing</b></font>'
          'MIT, every file. LazInk draws with its own engine - inkrender.pas, inkbox.pas and inkdraw.pas - and no third-party code remains in the package.'
          'Until 18 September 2026 the renderer came from JVCL and was MPL 1.1, which put conditions on anyone shipping a program built with it. That renderer has been replaced and deleted. See LICENSE and THIRD_PARTY_NOTICES.md, which keeps the history and the credit.'
        )
        SuperSubScriptRatio = 0.7
        Borders.Left = 10
        Borders.Top = 6
        Borders.Right = 10
        Borders.Bottom = 6
        LinkStyle.Color = clBlue
        LinkStyle.BackColor = clNone
        LinkStyle.Underline = False
        LinkHoverStyle.Color = clRed
        LinkHoverStyle.BackColor = clNone
        LinkHoverStyle.Underline = True
        OnLinkClick = memLinkClick
        WordWrap = True
        Align = alClient
        Color = clWindow
        Font.Color = clWindowText
        Font.Height = -14
        ParentColor = False
        ParentFont = False
        TabOrder = 0
      end
    end
  end

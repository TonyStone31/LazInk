      object lblWrapDemo: TInkLabel
        Left = 20
        Height = 80
        Top = 198
        Width = 560
        Caption = 'The renderer only ever broke a line where the markup said so, at a <b>&lt;br&gt;</b>. Word wrap works by re-writing the markup: measure the line, drop in a break at the last word that fits, and carry the still-open <b>tags</b> across so the second line stays <font color="#C0392B">exactly as formatted</font> as the first one was.'
        SuperSubScriptRatio = 0.7
        WordWrap = True
        LinkStyle.Color = clBlue
        LinkStyle.BackColor = clNone
        LinkStyle.Underline = False
        LinkHoverStyle.Color = clBlue
        LinkHoverStyle.BackColor = clNone
        LinkHoverStyle.Underline = True
        ParentColor = False
      end

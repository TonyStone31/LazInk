      object pnlEditArea: TPanel
        Left = 0
        Height = 630
        Top = 42
        Width = 1138
        Align = alClient
        BevelOuter = bvNone
        ClientHeight = 630
        ClientWidth = 1138
        TabOrder = 2
        object reMain: TInkRichEdit
          Cursor = crIBeam
          Left = 0
          Height = 630
          Top = 0
          Width = 620
          Markup.Strings = (
            '<font size="18"><b>Laz</b><font color="#2E86DE">Ink</font></font>'
            ''
            'This is a real WYSIWYG editor. The caret and the selection sit inside the <b>rendered</b> text — select a word, press <b>B</b>, and that run of characters stops being plain. Nothing has to round-trip through a source view first.'
            ''
            'Every glyph is drawn on a <i>TCanvas</i>, so it looks the same on gtk2, <b>gtk3</b>, qt5, win32 and cocoa. No RichMemo, no per-widgetset backend, no native text widget anywhere.'
            ''
            'It can do <font color="#C0392B">color</font>, <font bgcolor="#FBEEA8">highlight</font>, <font size="17">size</font>, <font face="DejaVu Serif">a different face</font>, <u>underline</u>, <s>strikeout</s>, H<sub>2</sub>O and E=mc<sup>2</sup>.'
            ''
            '<center>A centered paragraph, with a <a href="https://www.lazarus-ide.org/">link</a> in it. Ctrl+click to follow.</center>'
            ''
            'The panel on the right is the markup this document would be saved as; it keeps up as you type. Edit it over there and press <b>Apply</b> to send it back this way.'
          )
          SuperSubScriptRatio = 0.7
          OnChange = reMainChange
          OnSelectionChange = reMainSelectionChange
          OnLinkClick = reMainLinkClick
          Align = alLeft
          Font.Color = clWindowText
          Font.Height = -15
          ParentFont = False
          TabOrder = 0
        end

# Lazarus / Free Pascal build output
lib/
**/lib/
*.o
*.ppu
*.a
*.or
*.rsj
*.rst
*.res
*.compiled
*.dbg
*.exe
*.dll
*.so
*.dylib

# Lazarus per-user session and backup files
*.lps
backup/
**/backup/
*.bak
*.~*

# The demo's compiled program
demo/lazinkdemo
demo/lazinkdemo.app/

# Test and tool output
tests/results/
*.bmp

# Editors and operating systems
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# browser screenshots for the side-by-side comparison, which tools/compare.sh
# takes again whenever the page is newer than the picture
tests/compare/*-browser.png
tests/compare/*-snap-*.png
tests/compare/*-dryrun.png

# Python bytecode from the page generator
__pycache__/
*.pyc
